    "drizzle-orm": "^0.36.0",
    "express": "^4.19.0",
    "express-rate-limit": "^7.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.5.0"
