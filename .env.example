# Groq API — https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# SerpAPI — https://serpapi.com (100 searches/mo free)
SERPAPI_KEY=...

# Telegram Bot — https://core.telegram.org/bots/api
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_WEBHOOK_SECRET=some-random-string   # anything — acts as a URL password
API_BASE_URL=https://your-domain.com         # public URL of this API server

# Neon Postgres — https://neon.tech
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

